{
  "name": "dsh-mcp-server-clangd",
  "version": "0.1.0",
  "private": true,
  "description": "clangd 桥：把 clangd 包成 stdio MCP server，向 DSH agent 暴露 7 个只读 LSP 工具",
  "type": "module",
  "bin": {
    "mcp-server-clangd": "src/server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test \"tests/unit/*.test.js\" \"tests/integration/*.test.js\"",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:integration": "node --test \"tests/integration/*.test.js\"",
    "accept": "node scripts/accept.mjs"
  },
  "keywords": [
    "clangd",
    "mcp",
    "lsp",
    "dsh",
    "deepseek-harness"
  ],
  "license": "MIT"
}
